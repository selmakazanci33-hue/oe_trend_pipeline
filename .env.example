# --- Azure SQL (read-only, ActiveDirectoryInteractive) ---
# Same variable names as the reference project (834_issuer_etl/.env.example).
# Copy to .env and fill in. PASSWORD is not used.
SERVER=
DATABASE=
USERNAME=
DRIVER=ODBC Driver 17 for SQL Server
# Seconds to wait for interactive AAD sign-in (default 300 = 5 min)
CONNECTION_TIMEOUT=300
# AZURE_SQL_SERVER / AZURE_SQL_DATABASE / AZURE_SQL_USERNAME / AZURE_SQL_DRIVER aliases are also supported
